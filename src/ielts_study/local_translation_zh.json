  "target": [
    {"when": "\\bielts\\b", "replace": [["IELTS", "雅思"], ["ielts", "雅思"]]},
    {"when": "\\b(?:speaking|oral) (?:test|exam)\\b", "replace": [["口试", "口语考试"], ["演讲考试", "口语考试"], ["演讲测试", "口语考试"], ["发言测试", "口语考试"]]},

    {"when": "\\bplaybooks?\\b(?=.*(?:coach|team|football|basketball|quarterback|offen[cs]e|defen[cs]e|play-calling|game plan))|\\b(?:coach|team|football|basketball|quarterback|offen[cs]e|defen[cs]e|play-calling|game plan)\\b.*\\bplaybooks?\\b", "replace": [["游戏本", "战术手册"], ["剧本", "战术手册"]]},
    {"when": "\\b(?:(?:stay|be|being|staying|keep) consistent|consistency)\\b(?=.*(?:practi[cs]e|habit|learn|learning|english|study|studying|routine|every day|daily|improve|progress|fluency))|\\b(?:practi[cs]e|habit|learn|learning|english|study|studying|routine|every day|daily|improve|progress|fluency)\\b.*\\b(?:consistent|consistency)\\b|\\b(?:stay|staying) consistent\\b", "replace": [["保持一致", "坚持下去"], ["一致性", "坚持"]]},
